<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="PauseTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pause_bg</item>
        <item name="android:statusBarColor">@color/pause_bg</item>
        <item name="android:navigationBarColor">@color/pause_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
